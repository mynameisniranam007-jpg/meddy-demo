{
  "expo": {
    "name": "Medtriage",
    "slug": "medtriage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medtriage",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F4F8FA",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "อนุญาตให้ MedTriage ใช้ Face ID เพื่อเข้าสู่ระบบของคุณ"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
